<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>updatectl</title>
<style>
  body { font-family: -apple-system, Segoe UI, sans-serif; margin: 10px; font-size: 13px; }
  h2 { margin: 0 0 8px 0; }
  .pill { display: inline-block; padding: 1px 8px; font-size: 11px; background: #e6e6e6; border-radius: 9px; vertical-align: middle; }
  .bar { display: flex; gap: 8px; align-items: center; padding: 6px 0; border-bottom: 1px solid #ddd; margin-bottom: 8px; }
  .bar input[type=text] { flex: 1; padding: 3px 6px; border: 1px solid #bbb; border-radius: 3px; }
  .cols { display: grid; grid-template-columns: 320px 1fr; gap: 10px; }
  .col { border: 1px solid #ddd; border-radius: 4px; overflow: hidden; display: flex; flex-direction: column; min-height: 500px; }
  .col h3 { margin: 0; padding: 6px 8px; background: #f4f4f4; border-bottom: 1px solid #ddd; font-size: 13px; }
  .body { overflow: auto; flex: 1; }
  .row { padding: 6px 10px; border-bottom: 1px solid #f0f0f0; cursor: pointer; display: flex; align-items: center; gap: 6px; }
  .row:hover { background: #f8f8ff; }
  .row.selected { background: #eef6ff; }
  .row .name { flex: 1; }
  .row .sub { color: #888; font-size: 11px; }
  .statusDot { width: 10px; height: 10px; border-radius: 50%; box-shadow: 0 0 0 1px rgba(0,0,0,0.15); flex: 0 0 auto; }
  .statusDot.on { background: #2ecc40; }
  .statusDot.off { background: #d9534f; }
  .empty { padding: 20px; color: #999; text-align: center; }
  .infoBlock { padding: 10px; background: #f9f9f9; border-bottom: 1px solid #eee; display: flex; gap: 16px; flex-wrap: wrap; }
  .infoBlock .it { font-size: 12px; }
  .infoBlock .it b { display: block; color: #555; font-size: 11px; }
  .updTable { width: 100%; border-collapse: collapse; font-size: 12px; }
  .updTable th, .updTable td { padding: 5px 8px; border-bottom: 1px solid #f0f0f0; text-align: left; vertical-align: top; }
  .updTable th { background: #fafafa; position: sticky; top: 0; }
  .sev-Critical { color: #c0392b; font-weight: bold; }
  .sev-Important { color: #d68910; font-weight: bold; }
  .toolbar { padding: 6px 10px; background: #f4f4f4; border-bottom: 1px solid #ddd; display: flex; gap: 8px; align-items: center; }
  button { padding: 3px 8px; border: 1px solid #cfd5db; background: #f6f8fa; border-radius: 3px; cursor: pointer; font-size: 12px; }
  button.primary { background: #0d6efd; color: #fff; border-color: #0d6efd; }
  button:disabled { opacity: .5; cursor: not-allowed; }
  .badge { display: inline-block; padding: 1px 6px; border-radius: 8px; font-size: 10px; background: #e6e6e6; }
  .badge.warn { background: #fff3cd; color: #856404; }
  .badge.danger { background: #f8d7da; color: #721c24; }
  pre { background: #1e1e1e; color: #eee; padding: 8px; border-radius: 4px; font-size: 11px; max-height: 200px; overflow: auto; }
</style>
</head>
<body>

<h2>Windows Update Control <span id="cfgState" class="pill">prêt</span></h2>

<div class="cols">
  <div class="col">
    <h3>Postes <span id="agentCount" class="pill">0</span></h3>
    <div class="bar" style="padding:6px 8px;border-bottom:1px solid #eee">
      <input type="text" id="agentFilter" placeholder="Filtrer (nom, salle, OS)…">
      <button id="refreshAgents" title="Recharger la liste">↻</button>
    </div>
    <div class="bar" style="padding:6px 8px;border-bottom:1px solid #eee;background:#fafafa">
      <button id="prefetchBtn" title="Scanner en parallèle tous les postes en ligne visibles ci-dessous (max 8 simultanés)">⚡ Pré-charger visibles</button>
      <button id="installsBtn" title="Voir toutes les installs en cours et récentes">📋 Tâches</button>
      <span id="prefetchStatus" style="font-size:11px;color:#666;flex:1"></span>
    </div>
    <div class="body" id="agentList"><div class="empty">Chargement…</div></div>
  </div>

  <div class="col">
    <h3 id="rightTitle">Sélectionne un poste</h3>
    <div class="bar" style="padding:6px 10px;border-bottom:1px solid #eee;background:#fbfbfb;font-size:11px;color:#666">
      Scan auto : WSUS d'abord, fallback Windows Update direct si KO. La source réelle est affichée dans le résultat.
    </div>
    <div id="rightBody" class="body"><div class="empty">Choisis un poste à gauche pour interroger Windows Update.</div></div>
  </div>
</div>

<script>
  function $(id) { return document.getElementById(id); }
  function api(action, params, body) {
    var qs = 'action=' + encodeURIComponent(action);
    if (params) Object.keys(params).forEach(function (k) { qs += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(params[k]); });
    if (body) qs += '&payload=' + encodeURIComponent(JSON.stringify(body));
    return fetch('/pluginadmin.ashx?pin=updatectl&' + qs, { credentials: 'include' }).then(function (r) { return r.json(); });
  }
  function escapeHtml(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
      return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
    });
  }
  function humanSize(n) {
    if (!n) return '';
    if (n < 1024) return n + ' o';
    if (n < 1024 * 1024) return (n / 1024).toFixed(0) + ' Ko';
    if (n < 1024 * 1024 * 1024) return (n / 1024 / 1024).toFixed(1) + ' Mo';
    return (n / 1024 / 1024 / 1024).toFixed(2) + ' Go';
  }

  var agents = [];
  var selectedId = null;
  var lastInventory = null;
  var selectedUpdates = {};  // id -> true
  var cacheMap = {};   // nodeId -> { age, updates, rebootPending }
  var inflightSet = {}; // nodeId -> true scan
  var installsMap = {}; // dispatchId -> install entry
  var installsByNode = {}; // nodeId -> array of install entries

  function loadAgents() {
    api('agents').then(function (r) {
      if (r.error) {
        $('agentList').innerHTML = '<div class="empty" style="color:#721c24">' + escapeHtml(r.error) + '</div>';
        return;
      }
      agents = r.agents || [];
      renderAgents();
    });
  }

  function renderAgents() {
    var q = ($('agentFilter').value || '').toLowerCase().trim();
    var rows = agents.filter(function (a) {
      if (!q) return true;
      return [a.name, a.mesh, a.os].some(function (v) { return (v || '').toLowerCase().indexOf(q) !== -1; });
    });
    $('agentCount').textContent = rows.length + (rows.length !== agents.length ? ' / ' + agents.length : '');
    if (!rows.length) { $('agentList').innerHTML = '<div class="empty">Aucun poste.</div>'; return; }
    $('agentList').innerHTML = rows.map(function (a) {
      var sel = (a.id === selectedId) ? ' selected' : '';
      var dot = a.online ? 'on' : 'off';
      var badge = '';
      var nodeInstalls = installsByNode[a.id] || [];
      var runningInstall = nodeInstalls.find(function (it) { return it.status === 'running'; });
      if (runningInstall) {
        badge = '<span style="font-size:10px;color:#d68910" title="Install MAJ en cours">🔧</span>';
      } else if (inflightSet[a.id]) {
        badge = '<span style="font-size:10px;color:#0d6efd" title="Scan en cours">⏳</span>';
      } else if (cacheMap[a.id]) {
        var c = cacheMap[a.id];
        var cnt = c.updates;
        var color = cnt === 0 ? '#0a6b1a' : (cnt > 10 ? '#c0392b' : '#d68910');
        var rb = c.rebootPending ? ' 🔄' : '';
        badge = '<span style="font-size:10px;color:' + color + '" title="' + cnt + ' MAJ en cache (' + Math.round(c.age/1000) + 's)">⚡' + cnt + rb + '</span>';
      }
      return '<div class="row' + sel + '" data-id="' + escapeHtml(a.id) + '">'
           +   '<span class="statusDot ' + dot + '" title="' + (a.online ? 'En ligne' : 'Hors-ligne') + '"></span>'
           +   '<div class="name">'
           +     '<div>' + escapeHtml(a.name) + ' ' + badge + '</div>'
           +     '<div class="sub">' + escapeHtml(a.mesh) + ' · ' + escapeHtml(a.os) + '</div>'
           +   '</div>'
           + '</div>';
    }).join('');
    Array.prototype.forEach.call($('agentList').querySelectorAll('.row'), function (r) {
      r.onclick = function () {
        var id = r.getAttribute('data-id');
        selectedId = id;
        selectedUpdates = {};
        renderAgents();
        startInventory(id);
      };
    });
  }

  function startInventory(nodeId, forceRefresh) {
    var ag = agents.find(function (a) { return a.id === nodeId; });
    if (!ag) return;
    var refreshBtn = ' <button onclick="window.__refreshInv()" style="font-weight:normal;font-size:11px">↻ Forcer un nouveau scan</button>';
    $('rightTitle').innerHTML = '🔍 Inventaire — ' + escapeHtml(ag.name) + refreshBtn;
    window.__refreshInv = function () { startInventory(nodeId, true); };
    $('rightBody').innerHTML = '<div class="empty">Interrogation de l\'agent…<br><br>(cache ou nouveau scan jusqu\'à 5 min)</div>';
    if (!ag.online) {
      $('rightBody').innerHTML = '<div class="empty" style="color:#721c24">Poste hors-ligne — impossible d\'interroger Windows Update.</div>';
      return;
    }
    var params = { nodeId: nodeId };
    if (forceRefresh) params.refresh = '1';
    api('inventory', params).then(function (r) {
      if (!r.ok) {
        $('rightBody').innerHTML = '<div class="empty" style="color:#721c24">Erreur (WSUS + WU direct ont tous deux échoué) : ' + escapeHtml(r.error || 'inconnue') + '</div>'
          + (r.raw ? '<pre>' + escapeHtml(r.raw) + '</pre>' : '')
          + '<div style="padding:10px"><button onclick="window.__retry()">↻ Réessayer</button></div>';
        window.__retry = function () { startInventory(selectedId, true); };
        return;
      }
      lastInventory = r;
      renderInventory(r);
    });
  }

  function renderInventory(r) {
    var src = r.source || 'default';
    var srcBadge = '';
    if (src === 'wsus') srcBadge = '<span class="badge" style="background:#cfe2ff;color:#0a58ca">📡 WSUS</span>';
    else if (src === 'windowsupdate') {
      srcBadge = r.fallbackError
        ? '<span class="badge warn" title="WSUS a échoué : ' + escapeHtml(r.fallbackError) + '">🌐 Windows Update (fallback)</span>'
        : '<span class="badge" style="background:#d1e7dd;color:#0a3622">🌐 Windows Update</span>';
    } else srcBadge = '<span class="badge">' + escapeHtml(src) + '</span>';
    var info = '<div class="infoBlock">'
             + '<div class="it"><b>Source</b>' + srcBadge + '</div>'
             + '<div class="it"><b>Version</b>' + escapeHtml(r.winver || '?') + ' ' + escapeHtml(r.displayVersion || '') + (r.ubr ? ' (UBR ' + escapeHtml(r.ubr) + ')' : '') + '</div>'
             + '<div class="it"><b>Dernière MAJ</b>' + escapeHtml(r.lastInstall || '?') + '</div>'
             + '<div class="it"><b>Reboot pending</b>' + (r.rebootPending ? '<span class="badge danger">OUI</span>' : 'non') + '</div>'
             + '<div class="it"><b>MAJ en attente</b>' + (r.updates || []).length + (r.cached ? ' <span class="badge">cache ' + Math.round((r.age||0)/1000) + 's</span>' : '') + '</div>'
             + '</div>';

    var ups = r.updates || [];
    var tools = '<div class="toolbar">'
              + '<button id="selAll">Tout cocher</button>'
              + '<button id="selNone">Tout décocher</button>'
              + '<span style="flex:1"></span>'
              + '<button id="installSel" class="primary" disabled>⬇ Installer la sélection</button>'
              + '<button id="installAll">⬇ Tout installer</button>'
              + '</div>';

    var tbl;
    if (!ups.length) {
      tbl = '<div class="empty" style="color:#0a6b1a">✓ Aucune mise à jour en attente.</div>';
    } else {
      tbl = '<table class="updTable"><thead><tr>'
          + '<th style="width:30px"></th>'
          + '<th>Titre</th>'
          + '<th>KB</th>'
          + '<th>Sévérité</th>'
          + '<th>Taille</th>'
          + '<th>DL</th>'
          + '</tr></thead><tbody>';
      ups.forEach(function (u) {
        var sevCls = (u.severity === 'Critical' || u.severity === 'Important') ? ('sev-' + u.severity) : '';
        tbl += '<tr>'
             + '<td><input type="checkbox" class="upChk" data-id="' + escapeHtml(u.id) + '"></td>'
             + '<td>' + escapeHtml(u.title || '') + '</td>'
             + '<td>' + escapeHtml(u.kb || '') + '</td>'
             + '<td class="' + sevCls + '">' + escapeHtml(u.severity || '') + '</td>'
             + '<td>' + humanSize(u.size) + '</td>'
             + '<td>' + (u.downloaded ? '✓' : '') + '</td>'
             + '</tr>';
      });
      tbl += '</tbody></table>';
    }

    $('rightBody').innerHTML = info + tools + tbl;

    function refreshSel() {
      var count = Object.keys(selectedUpdates).length;
      var b = document.getElementById('installSel');
      if (b) { b.disabled = count === 0; b.textContent = '⬇ Installer la sélection' + (count ? ' (' + count + ')' : ''); }
    }
    Array.prototype.forEach.call(document.querySelectorAll('.upChk'), function (c) {
      c.onchange = function () {
        var id = c.getAttribute('data-id');
        if (c.checked) selectedUpdates[id] = true; else delete selectedUpdates[id];
        refreshSel();
      };
    });
    var bAll = document.getElementById('selAll');
    if (bAll) bAll.onclick = function () {
      ups.forEach(function (u) { selectedUpdates[u.id] = true; });
      Array.prototype.forEach.call(document.querySelectorAll('.upChk'), function (c) { c.checked = true; });
      refreshSel();
    };
    var bNone = document.getElementById('selNone');
    if (bNone) bNone.onclick = function () {
      selectedUpdates = {};
      Array.prototype.forEach.call(document.querySelectorAll('.upChk'), function (c) { c.checked = false; });
      refreshSel();
    };
    var bSel = document.getElementById('installSel');
    if (bSel) bSel.onclick = function () { doInstall(false); };
    var bInsAll = document.getElementById('installAll');
    if (bInsAll) bInsAll.onclick = function () { doInstall(true); };
    refreshSel();
  }

  function doInstall(all) {
    if (!selectedId) return;
    var updateIds = Object.keys(selectedUpdates);
    var verb = all ? ('TOUTES les ' + ((lastInventory && lastInventory.updates) || []).length + ' MAJ') : (updateIds.length + ' MAJ sélectionnée(s)');
    if (!confirm('Installer ' + verb + ' ?\n\nLe download + install peut prendre 30-60 min. Reste connecté à la page pour voir le résultat (l\'agent travaille en arrière-plan même si tu fermes la fenêtre).')) return;
    $('rightBody').innerHTML = '<div class="empty">⬇ Installation en cours (jusqu\'à 60 min)…<br><br>' + escapeHtml(verb) + '</div>';
    api('install', null, { nodeId: selectedId, updateIds: updateIds, all: all }).then(function (r) {
      if (!r.ok && r.error && !(r.installed || r.failed)) {
        $('rightBody').innerHTML = '<div class="empty" style="color:#721c24">Erreur : ' + escapeHtml(r.error) + '</div>'
          + (r.raw ? '<pre>' + escapeHtml(r.raw) + '</pre>' : '');
        return;
      }
      var installed = r.installed || [];
      var failed = r.failed || [];
      var srcLbl = r.source === 'wsus' ? '📡 WSUS' : (r.source === 'windowsupdate' ? '🌐 WU direct' : (r.source || '?'));
      var html = '<div class="infoBlock">'
               + '<div class="it"><b>Source</b>' + escapeHtml(srcLbl) + '</div>'
               + '<div class="it"><b>Installées</b>' + installed.length + '</div>'
               + '<div class="it"><b>Échouées</b>' + failed.length + '</div>'
               + '<div class="it"><b>Reboot requis</b>' + (r.rebootRequired ? '<span class="badge danger">OUI</span>' : 'non') + '</div>'
               + '</div>';
      if (installed.length) {
        html += '<div style="padding:10px"><b>✓ Installées :</b><ul>' + installed.map(function (u) { return '<li>' + escapeHtml(u.title) + '</li>'; }).join('') + '</ul></div>';
      }
      if (failed.length) {
        html += '<div style="padding:10px;color:#721c24"><b>✗ Échouées :</b><ul>' + failed.map(function (u) { return '<li>' + escapeHtml(u.title) + ' — ' + escapeHtml(u.error || '') + '</li>'; }).join('') + '</ul></div>';
      }
      if (r.raw) html += '<pre>' + escapeHtml(r.raw) + '</pre>';
      html += '<div style="padding:10px"><button onclick="startInventory(\'' + escapeHtml(selectedId) + '\')">↻ Refaire l\'inventaire</button></div>';
      $('rightBody').innerHTML = html;
    }).catch(function (e) {
      $('rightBody').innerHTML = '<div class="empty" style="color:#721c24">Erreur : ' + escapeHtml(e.message) + '</div>';
    });
  }

  function pollCache() {
    Promise.all([api('cacheStatus'), api('installs')]).then(function (rs) {
      var r = rs[0] || {};
      cacheMap = r.cache || {};
      inflightSet = {};
      (r.inflight || []).forEach(function (id) { inflightSet[id] = true; });
      var ri = rs[1] || {};
      installsMap = ri.installs || {};
      installsByNode = {};
      Object.keys(installsMap).forEach(function (id) {
        var it = installsMap[id];
        if (!installsByNode[it.nodeId]) installsByNode[it.nodeId] = [];
        installsByNode[it.nodeId].push(Object.assign({ dispatchId: id }, it));
      });
      renderAgents();
      // Si la modale Tâches est ouverte, rafraîchit son contenu.
      var open = document.getElementById('installsModal');
      if (open) renderInstallsModal(open);
    });
  }

  function openInstallsModal() {
    var bg = document.createElement('div');
    bg.id = 'installsModal';
    bg.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:100;display:flex;align-items:center;justify-content:center';
    bg.innerHTML = '<div style="background:#fff;border-radius:6px;max-width:900px;width:95%;max-height:80vh;display:flex;flex-direction:column">'
                 + '<div style="padding:10px;border-bottom:1px solid #ddd;display:flex;align-items:center"><h3 style="margin:0;flex:1">📋 Tâches d\'installation</h3>'
                 + '<button onclick="document.body.removeChild(document.getElementById(\'installsModal\'))">Fermer</button></div>'
                 + '<div id="installsBody" style="overflow:auto;padding:10px"></div>'
                 + '</div>';
    bg.onclick = function (e) { if (e.target === bg) document.body.removeChild(bg); };
    document.body.appendChild(bg);
    renderInstallsModal(bg);
  }
  function renderInstallsModal(bg) {
    var body = bg.querySelector('#installsBody');
    var nameById = {};
    agents.forEach(function (a) { nameById[a.id] = a.name; });
    var list = Object.keys(installsMap).map(function (id) { return Object.assign({ dispatchId: id }, installsMap[id]); });
    list.sort(function (a, b) { return (b.ts || 0) - (a.ts || 0); });
    if (!list.length) { body.innerHTML = '<div style="color:#999;text-align:center;padding:20px">Aucune tâche.</div>'; return; }
    var html = '<table style="width:100%;border-collapse:collapse;font-size:12px"><thead><tr>'
             + '<th style="padding:4px;border-bottom:2px solid #ccc;text-align:left">Poste</th>'
             + '<th style="padding:4px;border-bottom:2px solid #ccc;text-align:left">Quand</th>'
             + '<th style="padding:4px;border-bottom:2px solid #ccc;text-align:left">Statut</th>'
             + '<th style="padding:4px;border-bottom:2px solid #ccc;text-align:left">Mode</th>'
             + '<th style="padding:4px;border-bottom:2px solid #ccc;text-align:left">Résultat</th>'
             + '<th style="padding:4px;border-bottom:2px solid #ccc;text-align:left">Source</th>'
             + '<th style="padding:4px;border-bottom:2px solid #ccc"></th>'
             + '</tr></thead><tbody>';
    list.forEach(function (it) {
      var statusBadge;
      if (it.status === 'running') statusBadge = '<span style="color:#d68910">⏳ en cours</span>';
      else if (it.status === 'done') statusBadge = '<span style="color:#0a6b1a">✓ terminé</span>';
      else statusBadge = '<span style="color:#c0392b">✗ échec</span>';
      var when = new Date(it.ts).toLocaleString();
      var resultText = '';
      if (it.result) {
        var ins = (it.result.installed || []).length;
        var fail = (it.result.failed || []).length;
        var reboot = it.result.rebootRequired ? ' 🔄' : '';
        resultText = ins + ' ok / ' + fail + ' KO' + reboot;
      } else if (it.error) resultText = escapeHtml(it.error);
      var src = (it.result && it.result.source) || '';
      var srcLabel = src === 'wsus' ? '📡 WSUS' : (src === 'windowsupdate' ? '🌐 WU' : '');
      var clearBtn = (it.status !== 'running')
        ? '<button onclick="window.__clearInst(\'' + escapeHtml(it.dispatchId) + '\')">×</button>'
        : '';
      html += '<tr>'
            + '<td style="padding:4px;border-bottom:1px solid #f0f0f0">' + escapeHtml(nameById[it.nodeId] || it.nodeId.slice(0,12)) + '</td>'
            + '<td style="padding:4px;border-bottom:1px solid #f0f0f0;white-space:nowrap">' + escapeHtml(when) + '</td>'
            + '<td style="padding:4px;border-bottom:1px solid #f0f0f0">' + statusBadge + '</td>'
            + '<td style="padding:4px;border-bottom:1px solid #f0f0f0">' + escapeHtml(it.mode || '') + (it.mode === 'selection' ? ' (' + (it.updateIds || []).length + ')' : '') + '</td>'
            + '<td style="padding:4px;border-bottom:1px solid #f0f0f0">' + resultText + '</td>'
            + '<td style="padding:4px;border-bottom:1px solid #f0f0f0">' + srcLabel + '</td>'
            + '<td style="padding:4px;border-bottom:1px solid #f0f0f0;text-align:right">' + clearBtn + '</td>'
            + '</tr>';
    });
    html += '</tbody></table>';
    body.innerHTML = html;
    window.__clearInst = function (id) {
      api('clearInstall', { id: id }).then(pollCache);
    };
  }

  function visibleOnlineAgents() {
    var q = ($('agentFilter').value || '').toLowerCase().trim();
    return agents.filter(function (a) {
      if (!a.online) return false;
      if (!q) return true;
      return [a.name, a.mesh, a.os].some(function (v) { return (v || '').toLowerCase().indexOf(q) !== -1; });
    });
  }

  function prefetchVisible() {
    var pool = visibleOnlineAgents().filter(function (a) { return !cacheMap[a.id] && !inflightSet[a.id]; });
    if (!pool.length) { $('prefetchStatus').textContent = 'Rien à pré-charger (tout est déjà en cache).'; return; }
    if (!confirm('Lancer un scan WU en parallèle sur ' + pool.length + ' poste(s) ?\n\n8 simultanés, ~30s-2min par poste. Tu peux naviguer pendant ce temps — les résultats s\'affichent au fur et à mesure (badge ⚡ vert/orange/rouge).')) return;
    var concurrency = 8;
    var done = 0, total = pool.length, running = 0;
    var queue = pool.slice();
    $('prefetchStatus').textContent = '0/' + total + '…';
    function next() {
      while (running < concurrency && queue.length) {
        var a = queue.shift();
        running++;
        inflightSet[a.id] = true;
        renderAgents();
        api('inventory', { nodeId: a.id }).then(function () {
          done++; running--;
          $('prefetchStatus').textContent = done + '/' + total + (queue.length ? ' (' + queue.length + ' en file)' : ' terminé');
          pollCache();
          next();
        }).catch(function () {
          done++; running--;
          pollCache(); next();
        });
      }
      if (!queue.length && running === 0) {
        $('prefetchStatus').textContent = '✓ Terminé : ' + done + '/' + total;
        pollCache();
      }
    }
    next();
  }

  $('agentFilter').oninput = renderAgents;
  $('refreshAgents').onclick = loadAgents;
  $('prefetchBtn').onclick = prefetchVisible;
  $('installsBtn').onclick = openInstallsModal;
  loadAgents();
  pollCache();
  setInterval(pollCache, 10000);
</script>
</body>
</html>
